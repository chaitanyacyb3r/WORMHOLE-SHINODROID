# =============================================
# ShinobiDroid 忍ドロイド — .gitignore
# CRITICAL: Keep secrets out of version control
# =============================================

# ── Secrets & credentials ──────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.p12
*.jks
_key.txt

# ── OpenClaw secrets ────────────────────────────
.openclaw/
openclaw.json
openclaw-secrets.env

# ── Node.js ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tgz

# ── Next.js (web/) ─────────────────────────────
web/.next/
web/out/
web/build/
web/.env.local
web/.env.*.local

# ── Supabase ───────────────────────────────────
.supabase/
supabase/.temp/

# ── APK / Mobile binaries ───────────────────────
# Do NOT commit APK files (copyrighted + large)
*.apk
*.ipa
*.xapk
*.aab
*.appx
*.dex

# ── Scan output (large + potentially sensitive) ─
reports/
MobSF-Scans/
*.json.bak

# ── PDF reports ─────────────────────────────────
# Scan reports stay local only
ai-security-analysis.pdf
ai-security-analysis.html
dynamic-analysis-report.pdf
frida-results.json

# ── Temporary / runtime files ──────────────────
*.tmp
*.temp
*.log
logs/
tmp/

# ── OS / IDE ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
ehthumbs.db

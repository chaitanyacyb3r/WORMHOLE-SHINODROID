# =============================================
# WORMHOLE // ShinobiDroid - .gitignore
# CRITICAL: Keep secrets out of version control
# =============================================

# ── Secrets & credentials ──────────────────────
.env
*.env.local
*.env.production
*.pem
*.key
*.p12
*.jks

# ── Node.js ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Scan data (large + potentially sensitive) ──
# APK files are copyrighted / large binaries
*.apk
*.ipa
*.xapk
*.aab
*.appx

# MobSF reports (contain app analysis data)
reports/

# ── OS / IDE ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ───────────────────────────────────────
*.log
logs/

# ── Temporary files ────────────────────────────
_key.txt
*.tmp

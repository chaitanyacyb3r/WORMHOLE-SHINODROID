# ══════════════════════════════════════════════════════════════════════════════
# Shinodroid — Scan Worker Dockerfile
#
# Multi-stage build:
#   1. deps    — install Node.js dependencies
#   2. runner  — Node.js + Python + androwarn + analysis tools
#
# Handles: Static analysis orchestration, Database checks, AI triage,
#          Logcat parsing, report generation, APK cleanup
#
# NOTE: Dynamic analysis (Frida/ADB) requires an Android emulator and
#       cannot run inside containers. Run worker on host for dynamic scans.
#
# Security:
#   - Runs as non-root user (shinobi)
#   - No dev dependencies in final image
#   - Minimal attack surface (slim base)
#   - Temp files auto-cleaned
# ══════════════════════════════════════════════════════════════════════════════

FROM node:22-slim AS deps
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts --omit=dev

# ── Production Stage ──────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app

# Install Python 3 + pip (required for androwarn) + system deps for puppeteer/PDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    curl \
    ca-certificates \
    fonts-liberation \
    chromium \
    android-tools-adb \
    && rm -rf /var/lib/apt/lists/*

# Install androwarn in a virtual environment (best practice for Debian/Ubuntu)
RUN python3 -m venv /opt/androwarn-venv && \
    /opt/androwarn-venv/bin/pip install --no-cache-dir androwarn frida-tools && \
    ln -s /opt/androwarn-venv/bin/androwarn /usr/local/bin/androwarn && \
    ln -s /opt/androwarn-venv/bin/frida-ps /usr/local/bin/frida-ps && \
    ln -s /opt/androwarn-venv/bin/frida /usr/local/bin/frida

# Set Puppeteer to use installed Chromium (skip download)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROMIUM_PATH=/usr/bin/chromium

# Copy Node.js dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy application code
COPY package.json ./
COPY orchestrator.mjs ./
COPY dynamic-analyzer.mjs ./
COPY generate-dynamic-pdf.mjs ./
COPY custom-hooks-generator.mjs ./
COPY ui-explorer.mjs ./
COPY setup-emulator.ps1 ./
COPY src/ ./src/
COPY engines/ ./engines/
COPY scripts/ ./scripts/
COPY reporting/ ./reporting/

# Copy Convex generated files (worker imports ./web/convex/_generated/api.js)
# These are generated by `npx convex dev` and must exist before building
COPY web/convex/_generated/ ./web/convex/_generated/

# Create directories for reports, temp files, and web env mount point
RUN mkdir -p /app/reports /tmp/Shinodroid /app/web

ENV NODE_ENV=production
ENV REPORTS_OUTPUT_DIR=/app/reports

# Security: run as non-root
RUN groupadd --system --gid 1001 shinobi && \
    useradd --system --uid 1001 --gid shinobi shinobi && \
    chown -R shinobi:shinobi /app /tmp/Shinodroid

USER shinobi

# Health check — verifies the worker process is running
HEALTHCHECK --interval=60s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "process.exit(0)" || exit 1

CMD ["node", "src/daemon.mjs"]

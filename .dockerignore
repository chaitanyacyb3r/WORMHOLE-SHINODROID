# =============================================
# Shinodroid — Docker Ignore
# Keep build context small and secrets out
# =============================================

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Dependencies (rebuilt in container)
node_modules/

# Web dependencies — block everything EXCEPT what the worker needs
web/node_modules/
# Whitelist: worker imports Convex generated API + auth packages
!web/node_modules/convex/
!web/node_modules/@convex-dev/
!web/node_modules/@auth/

# Convex generated files — MUST be included for worker
!web/convex/_generated/

# Git
.git/
.gitignore

# Build output
web/.next/
web/out/
web/build/

# APKs and scan output (large + sensitive)
*.apk
*.ipa
*.xapk
*.aab
reports/
MobSF-Scans/

# PDFs and generated docs
*.pdf
ai-security-analysis.html
frida-results.json

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Dev/scratch files
*.log
*.tmp
*.temp
logs/
tmp/

# Documentation (not needed in container)
docs_ai/
figmadocs/
ai_claude_sonnet_6_search_srs/
pitch-deck/

# Gemini / AI artifacts
.gemini/

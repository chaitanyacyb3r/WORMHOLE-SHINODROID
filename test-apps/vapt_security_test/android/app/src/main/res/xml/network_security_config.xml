<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only trust pre-installed system CAs, ignoring user-installed proxy CAs -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
# ============================================================
# Shinodroid 忍ドロイド — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Windows (CMD):         copy .env.example .env
#
# NEVER commit .env to git — it contains secrets!
# ============================================================


# ── MobSF (required for static analysis) ──────────────────
# The default URL is correct if you run MobSF locally
MOBSF_URL=http://127.0.0.1:8000

# How to get your API key (run in PowerShell):
#   python -c "from hashlib import sha256; from pathlib import Path; print(sha256(Path.home().joinpath('.MobSF','secret').read_bytes().strip()).hexdigest())"
MOBSF_API_KEY=your_mobsf_api_key_here


# ── OWASP ZAP (required for backend network scanning) ──────
# Default API key used by the Docker container and local daemon.
ZAP_API_KEY=shinodroid-zap-key


# ── Scan directories ───────────────────────────────────────
# Where to drop APKs for folder-watch mode
# Leave blank to use C:\MobSF-Scans\inbox (auto-created if missing)
# Example: APK_INBOX_DIR=D:\Scans\inbox
APK_INBOX_DIR=

# Where engine output reports are saved
# Leave blank to use C:\MobSF-Scans\reports (auto-created if missing)
# Example: REPORTS_OUTPUT_DIR=D:\Scans\reports
REPORTS_OUTPUT_DIR=


# ── Supabase (required for web dashboard + scan worker) ───
# Create a free project at https://supabase.com
# Project Settings → API → Project URL & Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ── Ollama / AI Engine (required for AI security reports) ─
# Install Ollama from https://ollama.com, then run:
#   ollama pull minimax-text-01:cloud
# Default points to local Ollama instance
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=minimax-m2.7:cloud


# Leave blank to allow anyone (not recommended)


# ── Docker (auto-configured when using docker-compose) ─
# When running in Docker, MobSF is available as a sidecar container.
# The worker's MOBSF_URL is overridden to http://mobsf:8000 in docker-compose.yml.
# You do NOT need to change anything here for Docker — just run:
#   docker compose up -d

